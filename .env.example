# Salin fail ini kepada .env dan isi nilai
PORT=3000
ADMIN_USER=admin
ADMIN_PASS=ubah-kata-laluan-ini
# Akaun Master Admin: hanya boleh urus akaun Super Admin (tambah/padam/reset).
# Tukar kata laluan ini sebelum guna di produksi.
MASTER_USER=master
MASTER_PASS=ubah-kata-laluan-master-ini
# Pendaftaran sendiri (email + pautan pengesahan). 0 = tutup pendaftaran
REGISTRATION_OPEN=1
# URL awam aplikasi (untuk pautan pengesahan dalam e-mel). Jika kosong, host permintaan digunakan.
APP_URL=http://localhost:3000
# Email (contoh Gmail: guna App Password)
# WAJIB untuk hantar pautan/kod pengesahan pendaftaran & kod setup penjaga
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=caregiverproject2026@gmail.com
SMTP_PASS=app-password
MAIL_TO=keluarga@example.com,doktor@example.com
# Kunci penyulitan data (32-byte base64). WAJIB. Jangan kongsi.
# Jana sekali sahaja: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Jangan tukar selepas ada data — data lama tidak boleh dibaca.
DATA_KEY=
# Telegram (pilihan). Setiap super admin boleh tetapkan bot sendiri di tab Tetapan.
# Nilai di bawah ialah fallback global jika akaun belum tetapkan bot sendiri.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
